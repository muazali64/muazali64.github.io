<footer class="site-footer" role="contentinfo">
  {% if site.newsletter.enabled %}
    {% include newsletter.liquid %}
  {% endif %}
  <div class="container">
    <p>
      &copy; {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}.
      {% if site.last_updated %}Last updated {{ 'now' | date: '%B %d, %Y' }}.{% endif %}
      {% if site.impressum_path -%}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {%- endif %}
    </p>
    <p>{{ site.footer_text }}</p>
  </div>
</footer>
