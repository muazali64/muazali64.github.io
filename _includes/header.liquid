<header class="site-header" id="navbar">
  <div class="site-header__inner">
    <a class="wordmark" href="{{ '/' | relative_url }}">
      {%- if site.title == 'blank' -%}
        {{- site.first_name }}
        {{ site.last_name -}}
      {%- else -%}
        {{- site.title -}}
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Primary">
      {% for page_item in site.pages %}
        {% if page_item.permalink == '/' %}{% assign about_title = page_item.title %}{% endif %}
      {% endfor %}

      <a
        class="site-nav__link"
        href="{{ '/' | relative_url }}"
        {% if page.permalink == '/' %}
          aria-current="page"
        {% endif %}
      >
        {{- about_title -}}
      </a>

      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}
        {% if p.nav and p.autogen == null %}
          {%- if p.permalink contains '://' -%}
            {%- assign url = p.permalink -%}
          {%- elsif p.permalink contains '/blog/' -%}
            {%- assign url = '/blog/' -%}
          {%- else -%}
            {%- assign url = p.url -%}
          {%- endif -%}
          <a
            class="site-nav__link"
            href="{{ url | relative_url }}"
            {% if page.url contains p.url %}
              aria-current="page"
            {% endif %}
          >
            {{- p.title -}}
          </a>
        {% endif %}
      {% endfor %}

      {% if site.search_enabled %}
        <button id="search-toggle" class="site-nav__link" title="Search" onclick="openSearchModal()">
          <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
        </button>
      {% endif %}

      {% if site.enable_darkmode %}
        <button id="light-toggle" title="Change theme" aria-label="Change theme">
          <i class="ti ti-sun-moon" id="light-toggle-system"></i>
          <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
          <i class="ti ti-sun-filled" id="light-toggle-light"></i>
        </button>
      {% endif %}
    </nav>
  </div>
</header>
